# shellcheck shell=bash
# bz development environment — source via direnv or `. .envrc`

golangci-lint() {
  go tool -modfile=tools.go.mod golangci-lint --config=tools/lint/golangci.toml "$@"
}
export -f golangci-lint

gotestsum() {
  go tool -modfile=tools.go.mod gotestsum "$@"
}
export -f gotestsum

# Auto-install lefthook if missing
if command -v lefthook &>/dev/null && [ -f lefthook.yml ]; then
  lefthook install 2>/dev/null
fi
